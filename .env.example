# Fixora Marketplace Environment & External API Configuration Template
# Copy to .env or inject during CI/CD build

# 1. Firebase Production Services
# Download and place google-services.json under /app directory for production builds
FIREBASE_PROJECT_ID=fixora-marketplace-ae
FIREBASE_APPLICATION_ID=1:1234567890:android:abcdef123456
FIREBASE_API_KEY=AIzaSyA_SampleApiKeyForProductionUAE
FIREBASE_DATABASE_URL=https://fixora-marketplace-ae.firebaseio.com
FIREBASE_STORAGE_BUCKET=fixora-marketplace-ae.appspot.com

# 2. Google Maps Platform (Directions, Geocoding, Places)
GOOGLE_MAPS_API_KEY=AIzaSyB_SampleGoogleMapsAndroidKey

# 3. Payment Gateway (Stripe UAE / Network International / PayTabs)
PAYMENT_GATEWAY_ENVIRONMENT=sandbox # or production
PAYMENT_GATEWAY_PUBLISHABLE_KEY=pk_test_51NxSamplePublishableKey
PAYMENT_GATEWAY_SECRET_KEY=sk_test_51NxSampleSecretKey
PAYMENT_WEBHOOK_SIGNING_SECRET=whsec_sampleSecret123

# 4. Twilio / SMS Gateway for Phone OTP Authentication (UAE +971)
SMS_SERVICE_ACCOUNT_SID=ACsampleAccountSid
SMS_SERVICE_AUTH_TOKEN=sampleAuthToken
SMS_SERVICE_SENDER_ID=FIXORA
